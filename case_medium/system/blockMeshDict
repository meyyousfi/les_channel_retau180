//                        );
//    }
//    outlet
//    {
//        type            patch;
//        faces           (
//                         (1 2 6 5)
//                        );
//    }
    inlet
    {
        type            cyclic;
        neighbourPatch  outlet;
        faces           (
                         (0 4 7 3)
                        );
    }
    outlet
    {
        type            cyclic;
        neighbourPatch  inlet;
        faces           (
                         (1 2 6 5)
                        );
    }

);

